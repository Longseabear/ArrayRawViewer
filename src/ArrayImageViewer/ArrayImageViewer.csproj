  <!-- VSSDK suppresses Debugger.Interop by default because most VS installs
       provide a newer SDK variant. This extension uses the v8 interface and
       must ship that exact managed interop assembly for VS 2017+ hosts. -->
  <Target Name="AddDebuggerInteropToVsix" AfterTargets="GetVsixSourceItems">
    <ItemGroup>
      <VSIXSourceItem Include="$(NuGetPackageRoot)microsoft.visualstudio.debugger.interop\8.0.50729\lib\net11\Microsoft.VisualStudio.Debugger.Interop.dll">
